- if params[:category].present? || params[:model].present? || params[:brand].present? || params[:monthly_price].present?
  .mb-6.p-4.rounded-lg.border{style: 'background-color: #f0f6f6; border-color: #cfe5e5'}
    .flex.items-center.justify-between.flex-wrap.gap-4
      .flex.items-center.gap-2.flex-wrap
        %i.fas.fa-filter.mr-2{style: 'color: #F97316'}
        %span.text-sm.font-medium{style: 'color: #EA580C'}
          = t("filters.showing")
          %span.font-bold= @cars.count
          %span= t("filters.cars")
          = t("filters.filtered_by")

        / Show active filters as badges
        .flex.gap-2.flex-wrap
          - if params[:category].present?
            %span.inline-block.px-3.py-1.rounded-full.text-xs.font-semibold.text-white{style: 'background-color: #F97316'}
              = "#{t('filters.category_filter')} #{params[:category].capitalize}"

          - if params[:brand].present?
            %span.inline-block.px-3.py-1.rounded-full.text-xs.font-semibold.text-white{style: 'background-color: #F97316'}
              = "#{t('filters.brand_filter')} #{params[:brand].capitalize}"

          - if params[:model].present?
            %span.inline-block.px-3.py-1.rounded-full.text-xs.font-semibold.text-white{style: 'background-color: #F97316'}
              = "#{t('filters.model_filter')} #{params[:model].capitalize}"

          - if params[:monthly_price].present?
            %span.inline-block.px-3.py-1.rounded-full.text-xs.font-semibold.text-white{style: 'background-color: #F97316'}
              = "#{t('filters.price_filter')} #{params[:monthly_price]}"

      = link_to t("filters.clear_filters"), cars_path, class: 'text-sm font-semibold underline transition-all duration-300', style: 'color: #F97316'