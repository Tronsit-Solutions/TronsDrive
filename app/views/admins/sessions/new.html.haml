%html{ lang: "en" }
  %head
    %meta{ charset: "UTF-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1.0" }
    %title TronsDrive - Admin Login
    %script{ src: "https://cdn.tailwindcss.com" }
    %link{ href: "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css", rel: "stylesheet", crossorigin: "anonymous" }
    %style
      :css
        * { box-sizing: border-box; }
        body {
          min-height: 100vh;
          background: linear-gradient(135deg, #0A0F1E 0%, #0F172A 40%, #1a2744 70%, #0F172A 100%);
          background-size: 400% 400%;
          animation: gradientShift 20s ease infinite;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 1.5rem;
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        @keyframes gradientShift {
          0%   { background-position: 0% 50%; }
          50%  { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
        }
        /* Floating orbs */
        .orb {
          position: fixed;
          border-radius: 50%;
          filter: blur(80px);
          pointer-events: none;
          z-index: 0;
          animation: orbFloat 8s ease-in-out infinite;
        }
        .orb-1 {
          width: 400px; height: 400px;
          background: rgba(249,115,22,0.12);
          top: -100px; right: -100px;
        }
        .orb-2 {
          width: 300px; height: 300px;
          background: rgba(249,115,22,0.07);
          bottom: -80px; left: -80px;
          animation-delay: -4s;
        }
        @keyframes orbFloat {
          0%, 100% { transform: translateY(0px) scale(1); }
          50%       { transform: translateY(-20px) scale(1.05); }
        }
        .login-card {
          position: relative;
          z-index: 1;
          width: 100%;
          max-width: 420px;
          background: rgba(255,255,255,0.04);
          border: 1px solid rgba(249,115,22,0.2);
          border-radius: 20px;
          padding: 2.5rem 2rem;
          backdrop-filter: blur(20px);
          -webkit-backdrop-filter: blur(20px);
          box-shadow:
            0 8px 32px rgba(0,0,0,0.4),
            0 0 0 1px rgba(249,115,22,0.15),
            inset 0 1px 0 rgba(255,255,255,0.06);
        }
        .logo-ring {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 88px;
          height: 88px;
          border-radius: 50%;
          background: rgba(249,115,22,0.08);
          border: 2px solid rgba(249,115,22,0.35);
          box-shadow:
            0 0 0 6px rgba(249,115,22,0.06),
            0 0 28px rgba(249,115,22,0.25),
            inset 0 1px 0 rgba(255,255,255,0.08);
          margin-bottom: 1rem;
          animation: ringPulse 3s ease-in-out infinite;
        }
        @keyframes ringPulse {
          0%, 100% { box-shadow: 0 0 0 6px rgba(249,115,22,0.06), 0 0 28px rgba(249,115,22,0.25), inset 0 1px 0 rgba(255,255,255,0.08); }
          50%       { box-shadow: 0 0 0 10px rgba(249,115,22,0.03), 0 0 40px rgba(249,115,22,0.35), inset 0 1px 0 rgba(255,255,255,0.08); }
        }
        .brand-logo {
          height: 56px;
          width: auto;
          filter: drop-shadow(0 0 10px rgba(249,115,22,0.5)) brightness(1.05);
        }
        .brand-title {
          color: #ffffff;
          font-size: 1.875rem;
          font-weight: 800;
          letter-spacing: -0.02em;
          text-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }
        .brand-title span {
          color: #F97316;
        }
        .portal-badge {
          display: inline-flex;
          align-items: center;
          gap: 0.375rem;
          background: rgba(249,115,22,0.15);
          border: 1px solid rgba(249,115,22,0.3);
          color: #F97316;
          font-size: 0.75rem;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          padding: 0.25rem 0.75rem;
          border-radius: 999px;
          margin-top: 0.5rem;
        }
        .section-title {
          color: #F1F5F9;
          font-size: 1.1rem;
          font-weight: 700;
          text-align: center;
          margin-bottom: 1.5rem;
        }
        .divider {
          height: 1px;
          background: linear-gradient(to right, transparent, rgba(249,115,22,0.3), transparent);
          margin-bottom: 1.5rem;
        }
        .field-label {
          display: block;
          font-size: 0.8125rem;
          font-weight: 600;
          color: #94A3B8;
          margin-bottom: 0.4rem;
          letter-spacing: 0.03em;
        }
        .field-wrapper {
          position: relative;
        }
        .field-icon {
          position: absolute;
          left: 0.875rem;
          top: 50%;
          transform: translateY(-50%);
          color: #64748B;
          font-size: 0.875rem;
          pointer-events: none;
          transition: color 0.2s;
        }
        .form-input {
          width: 100%;
          background: rgba(255,255,255,0.05);
          border: 1px solid rgba(255,255,255,0.1);
          border-radius: 10px;
          color: #F1F5F9;
          font-size: 0.9375rem;
          padding: 0.7rem 0.875rem 0.7rem 2.5rem;
          outline: none;
          transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }
        .form-input::placeholder { color: #475569; }
        .form-input:focus {
          border-color: #F97316;
          background: rgba(249,115,22,0.06);
          box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
        }
        .toggle-pw {
          position: absolute;
          right: 0.875rem;
          top: 50%;
          transform: translateY(-50%);
          background: none;
          border: none;
          color: #475569;
          cursor: pointer;
          padding: 0;
          font-size: 0.875rem;
          transition: color 0.2s;
        }
        .toggle-pw:hover { color: #F97316; }
        .remember-label {
          font-size: 0.8125rem;
          color: #94A3B8;
          cursor: pointer;
          user-select: none;
        }
        .forgot-link {
          font-size: 0.8125rem;
          color: #F97316;
          text-decoration: none;
          font-weight: 500;
          transition: color 0.2s, opacity 0.2s;
        }
        .forgot-link:hover { opacity: 0.8; }
        .submit-btn {
          width: 100%;
          background: linear-gradient(135deg, #F97316 0%, #EA6C10 100%);
          color: #ffffff;
          font-size: 0.9375rem;
          font-weight: 700;
          border: none;
          border-radius: 10px;
          padding: 0.8rem 1.5rem;
          cursor: pointer;
          transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
          box-shadow: 0 4px 16px rgba(249,115,22,0.35);
          letter-spacing: 0.02em;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
        }
        .submit-btn:hover {
          transform: translateY(-1px);
          box-shadow: 0 6px 20px rgba(249,115,22,0.45);
        }
        .submit-btn:active { transform: translateY(0); }
        .error-box {
          background: rgba(220,38,38,0.1);
          border: 1px solid rgba(220,38,38,0.3);
          border-radius: 10px;
          padding: 0.75rem 1rem;
          margin-bottom: 1.25rem;
          color: #FCA5A5;
          font-size: 0.8125rem;
        }
        .custom-checkbox {
          width: 16px; height: 16px;
          accent-color: #F97316;
          cursor: pointer;
        }
        .back-link {
          display: inline-flex;
          align-items: center;
          gap: 0.375rem;
          color: #64748B;
          font-size: 0.8125rem;
          text-decoration: none;
          transition: color 0.2s;
          margin-bottom: 1.5rem;
        }
        .back-link:hover { color: #F97316; }

  %body
    .orb.orb-1
    .orb.orb-2

    .login-card
      / Back to site
      = link_to root_path, class: "back-link" do
        %i.fas.fa-arrow-left
        Back to site

      / Brand header
      .text-center{ style: "margin-bottom: 1.75rem;" }
        .flex.justify-center
          .logo-ring
            = image_tag "new_logo.png", alt: "TronsDrive Logo", class: "brand-logo"
        %h1.brand-title
          Trons
          %span Drive
        .flex.justify-center
          %span.portal-badge
            %i.fas.fa-shield-halved
            Admin Portal

      / Divider
      .divider

      / Form title
      %p.section-title Sign in to your account

      / Error messages
      - if resource.errors.any?
        .error-box
          %ul.list-disc.pl-4.space-y-1
            - resource.errors.full_messages.each do |msg|
              %li= msg

      / Form
      = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
        / Email
        .mb-4
          = f.label :email, class: "field-label"
          .field-wrapper
            %span.field-icon
              %i.fas.fa-envelope
            = f.email_field :email, autofocus: true, autocomplete: "email",
                class: "form-input",
                placeholder: "admin@tronsdrive.com",
                onfocus: "",
                onblur: ""

        / Password
        .mb-5
          = f.label :password, class: "field-label"
          .field-wrapper
            %span.field-icon
              %i.fas.fa-lock
            = f.password_field :password, autocomplete: "current-password",
                class: "form-input",
                style: "padding-right: 2.75rem;",
                placeholder: "••••••••",
                id: "admin_password"
            %button.toggle-pw{ type: "button", onclick: "togglePassword()", "aria-label": "Toggle password visibility" }
              %i.fas.fa-eye{ id: "pw-icon" }

        / Remember me & forgot password
        .flex.items-center.justify-between{ style: "margin-bottom: 1.5rem;" }
          .flex.items-center{ style: "gap: 0.5rem;" }
            = f.check_box :remember_me, class: "custom-checkbox", id: "remember_me"
            = f.label :remember_me, class: "remember-label"
          = link_to "Forgot password?", new_password_path(resource_name), class: "forgot-link"

        / Submit
        %button.submit-btn{ type: "submit" }
          %i.fas.fa-right-to-bracket
          Sign In

      / Footer note
      .text-center{ style: "margin-top: 1.5rem;" }
        %p{ style: "font-size: 0.75rem; color: #334155;" }
          Secure admin access &mdash; tronsDrive-FZCO

    :javascript
      function togglePassword() {
        var input = document.getElementById('admin_password');
        var icon  = document.getElementById('pw-icon');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
      }
