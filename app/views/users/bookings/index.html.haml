.w-full.min-h-screen{ style: "background: var(--td-bg);" }
  .px-4.md:px-12.lg:px-32

    = render 'shared/user_header'

    .mb-6
      = link_to user_home_path, class: 'inline-flex items-center font-semibold transition-colors', style: 'color: #F97316;' do
        %i.fas.fa-arrow-left.mr-2
        Back to Dashboard

    .rounded-3xl.shadow-xl.p-8.mt-0{ style: "background: var(--td-surface);" }
    / Flash messages
    - if flash[:alert]
      .mb-8.p-4.border-l-4.border-red-500.rounded-lg.font-medium.flex.items-center{ style: "background: rgba(239,68,68,0.1); color: #ef4444;" }
        %i.fas.fa-exclamation-circle.mr-3.text-lg
        = flash[:alert]

    / Header
    .container
      .flex.flex-col.sm:flex-row.items-start.sm:items-center.justify-between.mb-8.gap-4
        %h2.text-2xl.sm:text-3xl.font-bold.flex.items-center{ style: "color: var(--td-text);" }
          %i.fas.fa-calendar-alt.mr-2.sm:mr-4.text-xl.sm:text-2xl{ style: "color: #F97316;" }
          - if params[:filter] == 'active'
            Active Bookings
          - elsif params[:filter] == 'cancelled'
            Cancelled Bookings
          - else
            My Bookings
        .flex.items-center.space-x-4.w-full.sm:w-auto
          / Filter Dropdown
          .relative.flex-1.sm:flex-initial
            = form_with url: users_bookings_path, method: :get, local: true, class: 'flex items-center', id: 'filter-form' do |f|
              .relative.w-full
                = f.select :filter,
                    options_for_select([['All Bookings', 'all'],['Active Bookings', 'active'],['Cancelled Bookings', 'cancelled']], params[:filter] || 'all'),{},
                    { class: 'appearance-none border rounded-lg px-4 py-2 pr-8 text-sm font-medium focus:outline-none focus:ring-2 transition-colors shadow-sm w-full', style: 'background: var(--td-surface2); color: var(--td-text); border-color: var(--td-border);', id: 'booking-filter', onchange: 'this.form.submit()' }
                .absolute.inset-y-0.right-0.flex.items-center.pr-2.pointer-events-none
                  %i.fas.fa-chevron-down.text-xs{ style: "color: var(--td-muted);" }

      / Notifications Section
      - if current_user.bookings_notification?
        .grid.grid-cols-1.md:grid-cols-2.gap-3.md:gap-4.mb-6.md:mb-8
          / Unpaid Bookings Notification
          - if current_user.unpaid_bookings.any?
            .border-l-4.border-orange-500.rounded-lg.p-3.md:p-4.shadow-sm{ style: "background: rgba(249,115,22,0.08);" }
              .flex.items-start.gap-2.md:gap-3
                %i.fas.fa-credit-card.text-orange-500.text-lg.md:text-xl.mt-1
                .flex-1
                  %h3.text-sm.md:text-base.font-semibold.mb-1{ style: "color: #F97316;" } Payment Required
                  %p.text-xs.md:text-sm.mb-2{ style: "color: var(--td-text);" }
                    #{current_user.unpaid_bookings.count} booking#{current_user.unpaid_bookings.count == 1 ? '' : 's'} awaiting payment
                  %ul.text-xs.space-y-1.mb-2.md:mb-3{ style: "color: var(--td-muted);" }
                    - current_user.unpaid_bookings.limit(3).each do |booking|
                      %li.flex.items-center.gap-1
                        %i.fas.fa-circle.text-xs
                        - if booking.car
                          %span.truncate #{booking.car.brand} #{booking.car.model} - #{booking.start_date.strftime('%b %d')}
                        - else
                          %span.truncate Deleted Car - #{booking.start_date.strftime('%b %d')}
                    - if current_user.unpaid_bookings.count > 3
                      %li.font-semibold{ style: "color: #F97316;" } +#{current_user.unpaid_bookings.count - 3} more...

          / Failed Payments Notification
          - if current_user.failed_payments.any?
            .border-l-4.border-red-500.rounded-lg.p-3.md:p-4.shadow-sm{ style: "background: rgba(239,68,68,0.08);" }
              .flex.items-start.gap-2.md:gap-3
                %i.fas.fa-exclamation-circle.text-red-500.text-lg.md:text-xl.mt-1
                .flex-1
                  %h3.text-sm.md:text-base.font-semibold.text-red-500.mb-1 Payment Failed
                  %p.text-xs.md:text-sm.mb-2{ style: "color: var(--td-text);" }
                    #{current_user.failed_payments.count} payment#{current_user.failed_payments.count == 1 ? '' : 's'} failed
                  %p.text-xs.mb-2.md:mb-3{ style: "color: var(--td-muted);" } Please retry payment or contact support
                  = link_to users_bookings_path, class: 'inline-flex items-center font-semibold text-xs md:text-sm', style: 'color: #ef4444;' do
                    Retry Payment
                    %i.fas.fa-arrow-right.ml-1

      / Filter Summary
      - if @bookings.any? || params[:filter].present?
        .mb-6.p-4.rounded-lg.border{ style: "background: rgba(249,115,22,0.08); border-color: rgba(249,115,22,0.3);" }
          .flex.items-center.justify-between
            .flex.items-center
              %i.fas.fa-filter.mr-2{ style: "color: #F97316;" }
              %span.text-sm.font-medium{ style: "color: var(--td-text);" }
                - case params[:filter]
                - when 'active'
                  Showing #{@bookings.count} active booking#{@bookings.count == 1 ? '' : 's'} (pending and confirmed)
                - when 'cancelled'
                  Showing #{@bookings.count} cancelled booking#{@bookings.count == 1 ? '' : 's'}
                - else
                  Showing #{@bookings.count} booking#{@bookings.count == 1 ? '' : 's'} (all statuses)
            - if params[:filter].present? && params[:filter] != 'all'
              = link_to 'Clear Filter', users_bookings_path, class: 'text-sm underline', style: 'color: #F97316;'

      / Bookings List
      - if @bookings.any?
        .space-y-8.flex.flex-col.items-center
          - @bookings.each do |booking|
            .rounded-2xl.shadow-md.hover:shadow-lg.transition-shadow.duration-300.overflow-hidden.relative.w-full{ style: "background: var(--td-surface2); border: 1px solid var(--td-border);" }
              / Cancel Button - Top Right
              - if (booking.status == 'pending' || booking.status == 'confirmed') && !booking.payment_processed?
                .absolute.top-2.right-2.lg:top-4.lg:right-4.z-10
                  = button_to users_cancel_booking_path(booking.id),
                      method: :patch,
                      class: 'text-white px-2 py-1 lg:px-3 lg:py-1 rounded-lg text-xs lg:text-sm font-medium transition-all duration-200 shadow-md flex items-center',
                      style: 'background-color: #ef4444;',
                      onmouseover: "this.style.backgroundColor='#dc2626'",
                      onmouseout: "this.style.backgroundColor='#ef4444'",
                      data: { confirm: 'Are you sure you want to cancel this booking? This action cannot be undone.', turbo_confirm: 'Are you sure you want to cancel this booking? This action cannot be undone.' } do
                    %i.fas.fa-times.mr-1.text-xs.lg:text-sm
                    %span.hidden.sm:inline Cancel

              .flex.flex-col.lg:flex-row
                / Car Image Section
                .relative.w-full.lg_w-33.flex.items-center.justify-center.p-4.lg:p-6{ style: "background: var(--td-surface);" }
                  .w-full.h-48.lg:h-full.rounded-lg.overflow-hidden.flex.items-center.justify-center{ style: "background: var(--td-surface2);" }
                    - if booking.car
                      = car_main_image(booking.car, size: [400, 300])
                    - else
                      %i.fas.fa-car-crash.text-4xl{ style: "color: var(--td-muted);" }
                  / Status Badge
                  .absolute.top-4.left-4
                    - badge_style = case booking.status
                    - when 'confirmed' then 'background: rgba(16,185,129,0.15); color: #10b981;'
                    - when 'pending'   then 'background: rgba(245,158,11,0.15); color: #f59e0b;'
                    - when 'cancelled' then 'background: rgba(239,68,68,0.15);  color: #ef4444;'
                    - else                  'background: rgba(100,116,139,0.15); color: #64748b;'
                    %span.inline-flex.items-center.px-2.py-1.lg:px-3.lg:py-1.rounded-full.text-xs.lg:text-sm.font-medium.shadow-sm{ style: badge_style }
                      - if booking.status == 'confirmed'
                        %i.fas.fa-check-circle.mr-1.lg:mr-2.text-xs.lg:text-sm
                      - elsif booking.status == 'pending'
                        %i.fas.fa-clock.mr-1.lg:mr-2.text-xs.lg:text-sm
                      - elsif booking.status == 'cancelled'
                        %i.fas.fa-times-circle.mr-1.lg:mr-2.text-xs.lg:text-sm
                      = booking.status.titleize

                / Details Section
                .flex-1.p-4.lg:p-6
                  .flex.flex-col.h-full
                    / Car Info
                    %div
                      - if booking.car
                        %h3.text-xl.lg:text-2xl.font-bold.mb-2{ style: "color: var(--td-text);" }= "#{booking.car.brand} #{booking.car.model}"
                        .flex.flex-wrap.items-center.gap-x-3.lg:gap-x-6.gap-y-2.lg:gap-y-3.mb-4.text-sm.lg:text-base
                          .flex.items-center{ style: "color: var(--td-muted);" }
                            %i.fas.fa-calendar.mr-1.lg:mr-2.text-sm{ style: "color: #F97316;" }
                            = booking.car.year
                          .flex.items-center{ style: "color: var(--td-muted);" }
                            %i.fas.fa-palette.mr-1.lg:mr-2.text-sm{ style: "color: #F97316;" }
                            = booking.car.color
                          .flex.items-center{ style: "color: var(--td-muted);" }
                            %i.fas.fa-tag.mr-1.lg:mr-2.text-sm{ style: "color: #F97316;" }
                            = booking.car.category
                      - else
                        %h3.text-xl.lg:text-2xl.font-bold.italic.mb-2{ style: "color: #ef4444;" } Deleted Car
                        .text-sm.mb-4{ style: "color: var(--td-muted);" } This car is no longer available
                      .text-lg.lg:text-xl.font-semibold.mb-4{ style: "color: #F97316;" }
                        = number_to_currency(booking.selected_price)
                        - if booking.selected_period == 'daily'
                          %span.text-xs.lg:text-sm.font-normal.ml-1{ style: "color: var(--td-muted);" } per day
                        - elsif booking.selected_period == 'weekly'
                          %span.text-xs.lg:text-sm.font-normal.ml-1{ style: "color: var(--td-muted);" } per week
                        - elsif booking.selected_period == 'monthly'
                          %span.text-xs.lg:text-sm.font-normal.ml-1{ style: "color: var(--td-muted);" } per month
                        - elsif ['5 Hours', '10 Hours'].include?(booking.selected_period)
                          %span.text-xs.lg:text-sm.font-normal.ml-1{ style: "color: var(--td-muted);" } per service

                    / Rental Period
                    .rounded-xl.p-3.mb-4.lg:mb-6{ style: "background: var(--td-surface); border: 1px solid var(--td-border);" }
                      .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-3.sm:gap-4.text-xs.sm:text-sm
                        .flex.flex-wrap.items-center.gap-2.sm:gap-4
                          .flex.items-center{ style: "color: var(--td-text);" }
                            %i.fas.fa-calendar-day.mr-1.sm:mr-2.text-sm{ style: "color: #F97316;" }
                            %span.font-medium= booking.start_date.strftime('%b %d, %Y')

                          - unless ['5 Hours', '10 Hours'].include?(booking.selected_period)
                            %i.fas.fa-arrow-right.text-xs{ style: "color: var(--td-muted);" }
                            .flex.items-center{ style: "color: var(--td-text);" }
                              %i.fas.fa-calendar-day.mr-1.sm:mr-2.text-sm{ style: "color: #F97316;" }
                              %span.font-medium= booking.end_date.strftime('%b %d, %Y')

                        .flex.items-center.border-t.sm:border-t-0.sm:border-l.pt-2.sm:pt-0.sm:pl-4{ style: "border-color: var(--td-border);" }
                          %i.fas.fa-clock.mr-1.sm:mr-2.text-sm{ style: "color: #F97316;" }
                          - if ['5 Hours', '10 Hours'].include?(booking.selected_period)
                            %span.font-bold{ style: "color: #F97316;" }= booking.selected_period
                          - else
                            %span.font-bold{ style: "color: #F97316;" }= pluralize((booking.end_date - booking.start_date).to_i, 'day')

                    / Payment Section
                    .mt-auto.pt-3.lg:pt-4.border-t{ style: "border-color: var(--td-border);" }
                      .flex.flex-col.gap-3.lg:gap-4
                        .flex-1
                          - duration_days = (booking.end_date - booking.start_date).to_i
                          - daily_price = booking.car&.daily_price.to_f || (booking.total_amount ? booking.total_amount / [duration_days, 1].max : 0)

                          / Pricing breakdown based on selected period
                          - if booking.selected_period == 'weekly'
                            - weekly_price = booking.car&.weekly_price.to_f || (daily_price * 7)
                            - full_weeks = duration_days / 7
                            - remaining_days = duration_days % 7
                            - total_amount = (full_weeks * weekly_price) + (remaining_days * daily_price)
                            %p.text-xs.sm:text-sm.mb-2{ style: "color: var(--td-muted);" }
                              %span.font-medium{ style: "color: var(--td-text);" } Pricing:
                              %span.ml-1
                                = "#{full_weeks} week#{full_weeks == 1 ? '' : 's'} × AED #{weekly_price.to_i}"
                                - if remaining_days > 0
                                  %span.ml-1 + #{remaining_days} day#{remaining_days == 1 ? '' : 's'} × AED #{daily_price.to_i}

                          - elsif booking.selected_period == 'monthly'
                            - monthly_price = booking.car&.monthly_price.to_f || (daily_price * 30)
                            - full_months = duration_days / 30
                            - remaining_days = duration_days % 30
                            - total_amount = (full_months * monthly_price) + (remaining_days * daily_price)
                            %p.text-xs.sm:text-sm.mb-2{ style: "color: var(--td-muted);" }
                              %span.font-medium{ style: "color: var(--td-text);" } Pricing:
                              %span.ml-1
                                = "#{full_months} month#{full_months == 1 ? '' : 's'} × AED #{monthly_price.to_i}"
                                - if remaining_days > 0
                                  %span.ml-1 + #{remaining_days} day#{remaining_days == 1 ? '' : 's'} × AED #{daily_price.to_i}

                          - elsif ['5 Hours', '10 Hours'].include?(booking.selected_period)
                            - total_amount = booking.selected_price.to_f
                            %p.text-xs.sm:text-sm.mb-2{ style: "color: var(--td-muted);" }
                              %span.font-medium{ style: "color: var(--td-text);" } Pricing:
                              %span.ml-1= "1 Service (#{booking.selected_period}) × AED #{total_amount.to_i}"

                          - else
                            - total_amount = duration_days * daily_price
                            %p.text-xs.sm:text-sm.mb-2{ style: "color: var(--td-muted);" }
                              %span.font-medium{ style: "color: var(--td-text);" } Pricing:
                              %span.ml-1= "#{duration_days} days × AED #{daily_price.to_i}"

                          / Discount if applicable
                          - if booking.has_discount?
                            %p.text-xs.sm:text-sm.mb-2.flex.items-center{ style: "color: #ef4444;" }
                              %i.fas.fa-tag.mr-1
                              %span.font-medium= "Discount (#{booking.discount_percentage}% OFF):"
                              %span.ml-1= "- AED #{booking.discount_amount.to_i}"

                          / Delivery/Pickup Charge if selected
                          - if booking.delivery_option.present?
                            %p.text-xs.sm:text-sm.mb-2{ style: "color: #a855f7;" }
                              %i{class: booking.delivery_option == 'delivery' ? 'fas fa-shipping-fast' : 'fas fa-car'}
                              %span.font-medium= " #{booking.delivery_option.capitalize} Charge:"
                              %span.ml-1= "AED #{booking.delivery_charge.to_i}"

                          / Total Amount
                          - if booking.has_discount?
                            .flex.flex-col.items-start
                              %p.text-sm.line-through{ style: "color: var(--td-muted);" }
                                = number_to_currency(total_amount + booking.delivery_charge)
                              %p.text-xl.lg:text-2xl.font-bold{ style: "color: #10b981;" }
                                = number_to_currency(booking.total_amount)
                          - else
                            %p.text-xl.lg:text-2xl.font-bold{ style: "color: #10b981;" }
                              = number_to_currency(total_amount + booking.delivery_charge)

                        / Status Pills + Action Button
                        .flex.flex-col.sm:flex-row.items-stretch.sm:items-center.gap-2.sm:gap-3
                          / Status Pills
                          .flex.flex-wrap.gap-2
                            / Booking Status
                            - badge_style = case booking.status
                            - when 'confirmed' then 'background: rgba(16,185,129,0.15); color: #10b981;'
                            - when 'pending'   then 'background: rgba(245,158,11,0.15); color: #f59e0b;'
                            - when 'cancelled' then 'background: rgba(239,68,68,0.15);  color: #ef4444;'
                            - else                  'background: rgba(100,116,139,0.15); color: #64748b;'
                            %span.inline-flex.items-center.justify-center.px-3.py-1.rounded-full.text-xs.font-medium.shadow-sm.whitespace-nowrap{ style: badge_style }
                              - if booking.status == 'confirmed'
                                %i.fas.fa-check-circle.mr-1.text-xs
                              - elsif booking.status == 'pending'
                                %i.fas.fa-clock.mr-1.text-xs
                              - elsif booking.status == 'cancelled'
                                %i.fas.fa-times-circle.mr-1.text-xs
                              = booking.status.titleize

                            / Payment Status
                            - pay_style = case booking.payment_status
                            - when 'paid'           then 'background: rgba(16,185,129,0.15);  color: #10b981;'
                            - when 'pending'        then 'background: rgba(245,158,11,0.15);  color: #f59e0b;'
                            - when 'unpaid'         then 'background: rgba(239,68,68,0.15);   color: #ef4444;'
                            - when 'refunded'       then 'background: rgba(168,85,247,0.15);  color: #a855f7;'
                            - when 'refund_pending' then 'background: rgba(249,115,22,0.15);  color: #F97316;'
                            - else                       'background: rgba(100,116,139,0.15); color: #64748b;'
                            %span.inline-flex.items-center.justify-center.px-3.py-1.rounded-full.text-xs.font-medium.shadow-sm.whitespace-nowrap{ style: pay_style }
                              - if booking.payment_status == 'paid'
                                %i.fas.fa-check-circle.mr-1.text-xs
                              - elsif booking.payment_status == 'pending'
                                %i.fas.fa-clock.mr-1.text-xs
                              - elsif booking.payment_status == 'unpaid'
                                %i.fas.fa-times-circle.mr-1.text-xs
                              - elsif booking.payment_status == 'refunded'
                                %i.fas.fa-undo.mr-1.text-xs
                              - elsif booking.payment_status == 'refund_pending'
                                %i.fas.fa-hourglass-half.mr-1.text-xs
                              = "Payment: #{booking.payment_status.titleize}"

                          / Action Buttons
                          - if booking.cancelled_with_refund?
                            = link_to users_booking_path(booking), class: 'text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-sm sm:text-base font-semibold transition-all duration-200 shadow-md flex items-center justify-center', style: 'background-color: #ef4444;', onmouseover: "this.style.backgroundColor='#dc2626'", onmouseout: "this.style.backgroundColor='#ef4444'" do
                              %i.fas.fa-exclamation-circle.mr-2
                              View Details
                          - elsif !current_user.documents_approved?
                            .payment-disabled.px-4.sm:px-6.py-2.sm:py-3.rounded-lg.text-sm.sm:text-base.font-semibold.cursor-not-allowed.flex.items-center.justify-center.opacity-60{ style: 'background: var(--td-surface2); color: var(--td-muted); border: 1px solid var(--td-border);', title: 'Payment is disabled until your documents are approved' }
                              %i.fas.fa-lock.mr-2
                              Payment Disabled
                          - else
                            = link_to users_payment_path(booking.id), class: 'text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-sm sm:text-base font-semibold transition-all duration-200 shadow-md flex items-center justify-center', style: 'background-color: #F97316;', onmouseover: "this.style.backgroundColor='#EA580C'", onmouseout: "this.style.backgroundColor='#F97316'" do
                              %i.fas.fa-eye.mr-2
                              View/Pay Booking


      - else
        .text-center.py-16
          .max-w-md.mx-auto
            .rounded-3xl.p-8.flex.flex-col.items-center{ style: "background: var(--td-surface2);" }
              .w-20.h-20.rounded-full.flex.items-center.justify-center.mb-6{ style: "background: rgba(249,115,22,0.1);" }
                %i.fas.fa-calendar-times.text-3xl{ style: "color: #F97316;" }
              %h3.text-xl.font-semibold.mb-3{ style: "color: var(--td-text);" } No Bookings Yet
              %p.mb-6{ style: "color: var(--td-muted);" } It looks like you haven't made any bookings yet. Browse our collection to find your perfect car.
              = link_to cars_path, class: 'text-white font-semibold py-3 px-8 rounded-lg shadow transition-all duration-200 inline-flex items-center space-x-2', style: 'background-color: #F97316;', onmouseover: "this.style.backgroundColor='#EA580C'", onmouseout: "this.style.backgroundColor='#F97316'" do
                %i.fas.fa-car
                %span Explore Cars

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('form[action*="/cancel"]').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        if (!confirm('Are you sure you want to cancel this booking? This action cannot be undone.')) {
          e.preventDefault();
          return false;
        }
      });
    });

    const filterSelect = document.getElementById('booking-filter');
    if (filterSelect) {
      filterSelect.addEventListener('change', function() {
        const form = document.getElementById('filter-form');
        if (form) {
          const submitButton = document.createElement('button');
          submitButton.type = 'submit';
          submitButton.style.display = 'none';
          form.appendChild(submitButton);
          submitButton.click();
        }
      });
    }

    document.querySelectorAll('.pay-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        if (btn.dataset.pendingDocs === 'true') {
          e.preventDefault();
          alert("Your documents are under review. We'll notify you once they're approved, and you can proceed with your booking.");
        }
      });
    });
  });
